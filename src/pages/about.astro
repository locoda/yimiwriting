---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
import AboutSection from "../components/aboutsection.astro";
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">About</Fragment>
      <!-- <Fragment slot="desc"> Who I am and Where you can find me. </Fragment> -->
    </Sectionhead>

    <div class="flex flex-col gap-4 md:gap-8 mx-auto max-w-3xl mt-16">
      <AboutSection title="Bio">
        Yimi Lu grew up in Shanghai and now pretends to settle in Northern California. She builds code by day and disassembles herself by night to see what remains. Find her at https://www.yimiwriting.com/ 
      </AboutSection>

      <AboutSection title="Socials">
        @yimiwriting
      </AboutSection>

      <AboutSection title="Email"> yimiwriting@outlook.com </AboutSection>
    </div>
  </Container>
</Layout>
