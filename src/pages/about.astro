---
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
import AboutSection from "../components/aboutsection.astro";
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">About</Fragment>
    </Sectionhead>

    <div class="max-w-2xl mt-10 md:mt-12">
      <AboutSection title="Bio">
        Yimi Lu grew up in Shanghai and now pretends to settle in Northern
        California. She builds code by day and disassembles herself by night to
        see what remains.
      </AboutSection>

      <AboutSection title="Socials">
        <a
          href="https://twitter.com/yimiwriting"
          target="_blank"
          rel="noopener"
          class="link-accent transition-colors"
        >
          @yimiwriting
        </a>
      </AboutSection>

      <AboutSection title="Email">
        <a
          href="mailto:yimiwriting@outlook.com"
          class="link-accent transition-colors"
        >
          yimiwriting@outlook.com
        </a>
      </AboutSection>
    </div>
  </Container>
</Layout>
