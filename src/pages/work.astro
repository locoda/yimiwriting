---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";
import PostMeta from "../components/postmeta.astro";

// Get all non-draft entries
const workEntries = await getCollection("work", ({ data }) => {
  return !data.draft;
});

// Sort content entries by publication date
workEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

const now = new Date();
---

<Layout title="Work">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Work</Fragment>
      <Fragment slot="desc"> The pieces I've created. Forthcoming... </Fragment>
    </Sectionhead>
    <main class="mt-16">
      <ul class="grid gap-16 max-w-4xl mx-auto">
        {
          workEntries.map((workPostEntry, index) => {
            const isForthcoming = workPostEntry.data.publishDate > now;

            const content = (
              <div class="grid md:grid-cols-2 gap-5 md:gap-10 items-center">
                <Picture
                  src={workPostEntry.data.image.src}
                  alt={workPostEntry.data.image.alt}
                  sizes="(max-width: 800px) 100vw, 800px"
                  width={800}
                  height={600}
                  loading={index <= 2 ? "eager" : "lazy"}
                  decoding={index <= 2 ? "sync" : "async"}
                  class="w-full rounded-md object-cover object-center bg-white"
                />
                <div>
                  <PostMeta
                    category={workPostEntry.data.category}
                    publishDate={workPostEntry.data.publishDate}
                  />

                  <h2 class="text-3xl font-semibold leading-snug tracking-tight mt-1 ">
                    {workPostEntry.data.title}
                  </h2>
                </div>
              </div>
            );

            if (isForthcoming) {
              return <li>{content}</li>;
            }

            const url = workPostEntry.data.external
              ? workPostEntry.data.external
              : `/work/${workPostEntry.slug}`;
            const target = workPostEntry.data.external ? "_blank" : undefined;
            const rel = workPostEntry.data.external ? "noopener noreferrer" : undefined;

            return (
              <li>
                <a href={url} target={target} rel={rel}>
                  {content}
                </a>
              </li>
            );
          })
        }
      </ul>
    </main>
  </Container>
</Layout>
