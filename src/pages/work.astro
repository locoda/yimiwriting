---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";

// Get all non-draft entries
const workEntries = await getCollection("work", ({ data }) => {
  return !data.draft;
});

// Sort content entries by publication date
workEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

const now = new Date();
const genres = ["fiction", "non-fiction", "poetry"];
---

<Layout title="Work">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Work</Fragment>
    </Sectionhead>

    <main class="mt-10 md:mt-12 space-y-12 md:space-y-14">
      {
        genres.map((genre) => {
          const posts = workEntries.filter(
            (entry) => entry.data.genre === genre
          );
          if (posts.length === 0) return null;
          const genreTitle =
            genre === "non-fiction"
              ? "Non-fiction"
              : genre.charAt(0).toUpperCase() + genre.slice(1);
          return (
            <section>
              <div class="max-w-3xl">
                <h2 class="kicker text-muted mb-2">
                  {genreTitle}
                </h2>
                <ul>
                  {
                    posts.map((workPostEntry) => {
                      const isForthcoming =
                        workPostEntry.data.publishDate > now;
                      const formattedDate = isForthcoming
                        ? "Forthcoming"
                        : workPostEntry.data.publishDate.toLocaleDateString(
                            "en-US",
                            {
                              year: "numeric",
                              month: "long",
                            }
                          );

                      const content = (
                        <div class="flex items-start justify-between gap-3">
                          <div class="min-w-0">
                            <h3
                              class:list={[
                                "font-serif text-xl leading-snug tracking-tight",
                                isForthcoming
                                  ? "text-muted"
                                  : "text-fg group-hover:text-accent transition-colors",
                              ]}
                            >
                              {workPostEntry.data.title}
                            </h3>
                            <p class="font-sans text-xs tracking-[0.08em] uppercase text-muted mt-2">
                              <span class="text-accent">{workPostEntry.data.category}</span> · {formattedDate} ·{" "}
                              {workPostEntry.data.magazine}
                            </p>
                          </div>
                          <svg
                            class="shrink-0 mt-1.5 text-accent"
                            width="16" height="16" viewBox="0 0 24 24"
                            fill="none" stroke="currentColor"
                            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                          >
                            <line x1="5" y1="12" x2="19" y2="12"/>
                            <polyline points="12 5 19 12 12 19"/>
                          </svg>
                        </div>
                      );

                      if (isForthcoming) {
                        return (
                          <li class="border-b border-border last:border-b-0 opacity-60">
                            <div class="py-5">{content}</div>
                          </li>
                        );
                      }

                      const url = workPostEntry.data.external
                        ? workPostEntry.data.external
                        : `/work/${workPostEntry.id}`;
                      const target = workPostEntry.data.external
                        ? "_blank"
                        : undefined;
                      const rel = workPostEntry.data.external
                        ? "noopener noreferrer"
                        : undefined;

                      return (
                        <li class="border-b border-border last:border-b-0">
                          <a
                            href={url}
                            target={target}
                            rel={rel}
                            class="group block py-5"
                          >
                            {content}
                          </a>
                        </li>
                      );
                    })
                  }
                </ul>
              </div>
            </section>
          );
        })
      }
    </main>
  </Container>
</Layout>
