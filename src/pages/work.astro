---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";

// Filter blog entries with 'draft: false' & date before current date
const publishedWorkEntries = await getCollection("work", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

// Sort content entries by publication date
publishedWorkEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});
---

<Layout title="Work">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Work</Fragment>
      <Fragment slot="desc"> The pieces I've created. Forthcoming... </Fragment>
    </Sectionhead>
    <main class="mt-16">
      <ul class="grid gap-16 max-w-4xl mx-auto">
        {
          publishedWorkEntries.map((workPostEntry, index) => (
            <li>
              <a
                href={
                  workPostEntry.data.external
                    ? workPostEntry.data.external
                    : `/work/${workPostEntry.slug}`
                }
                target={workPostEntry.data.external ? "_blank" : undefined}
                rel={workPostEntry.data.external ? "noopener noreferrer" : undefined}
              >
                <div class="grid md:grid-cols-2 gap-5 md:gap-10 items-center">
                  <Picture
                    src={workPostEntry.data.image.src}
                    alt={workPostEntry.data.image.alt}
                    sizes="(max-width: 800px) 100vw, 800px"
                    width={800}
                    height={600}
                    loading={index <= 2 ? "eager" : "lazy"}
                    decoding={index <= 2 ? "sync" : "async"}
                    class="w-full rounded-md object-cover object-center bg-white"
                  />
                  <div>
                    <span class="text-hh15-accent uppercase tracking-wider text-sm font-medium">
                      {workPostEntry.data.category}
                    </span>

                    <h2 class="text-3xl font-semibold leading-snug tracking-tight mt-1 ">
                      {workPostEntry.data.title}
                    </h2>

                    <div class="flex gap-2 mt-3">
                      <time
                        class="text-hh15-muted"
                        datetime={workPostEntry.data.publishDate.toISOString()}
                      >
                        {workPostEntry.data.publishDate.toLocaleDateString(
                          "en-US",
                          {
                            year: "numeric",
                            month: "long", // 可以改成 "2-digit" 显示数字月份
                          }
                        )}
                      </time>
                    </div>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </Container>
</Layout>
