---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "../components/container.astro";
import Sectionhead from "../components/sectionhead.astro";

// Get all non-draft entries
const workEntries = await getCollection("work", ({ data }) => {
  return !data.draft;
});

// Sort content entries by publication date
workEntries.sort(function (a, b) {
  return b.data.publishDate.valueOf() - a.data.publishDate.valueOf();
});

const now = new Date();
---

<Layout title="Work">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Work</Fragment>
      <!-- <Fragment slot="desc"> The pieces I've created. Forthcoming... </Fragment> -->
    </Sectionhead>
    <main class="mt-16">
      <ul class="flex flex-col gap-8 max-w-6xl mx-auto">
        {
          workEntries.map((workPostEntry) => {
            const isForthcoming = workPostEntry.data.publishDate > now;
            const formattedDate = isForthcoming
              ? "Forthcoming"
              : workPostEntry.data.publishDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                });

            const content = (
              <div class="grid gap-2 md:grid-cols-[1fr_auto_auto_auto] md:gap-4">
                <h2 class="text-xl font-semibold leading-snug tracking-tight">
                  {workPostEntry.data.title}
                </h2>
                <span class="text-hh15-accent uppercase tracking-wider">
                  {workPostEntry.data.category}
                </span>
                {isForthcoming ? (
                  <span class="text-hh15-muted">{formattedDate}</span>
                ) : (
                  <time
                    class="text-hh15-muted whitespace-nowrap"
                    datetime={workPostEntry.data.publishDate.toISOString()}
                  >
                    {formattedDate}
                  </time>
                )}
                <span class="text-hh15-muted">
                  {workPostEntry.data.magazine}
                </span>
              </div>
            );

            if (isForthcoming) {
              return <li>{content}</li>;
            }

            const url = workPostEntry.data.external
              ? workPostEntry.data.external
              : `/work/${workPostEntry.slug}`;
            const target = workPostEntry.data.external ? "_blank" : undefined;
            const rel = workPostEntry.data.external
              ? "noopener noreferrer"
              : undefined;

            return (
              <li>
                <a href={url} target={target} rel={rel}>
                  {content}
                </a>
              </li>
            );
          })
        }
      </ul>
    </main>
  </Container>
</Layout>
