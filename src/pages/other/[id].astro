---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PostPreview from '../../components/PostPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const other = (await getCollection('other')).sort(sortItemsByDateDesc);
    const workCount = other.length;
    return other.map((work, index) => ({
        params: { id: work.id },
        props: {
            work,
            prevWork: index + 1 !== workCount ? other[index + 1] : null,
            nextWork: index !== 0 ? other[index - 1] : null
        }
    }));
}

type Props = {
    work: CollectionEntry<'other'>;
    prevWork: CollectionEntry<'other'>;
    nextWork: CollectionEntry<'other'>;
};

const { work, prevWork, nextWork } = Astro.props;
const { title, description, seo } = work.data;
const { Content } = await render(work);
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description} image={seo?.image} pageType="article" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight">{title}</h1>
        </header>
        <div class="max-w-none prose sm:prose-lg">
            <Content />
        </div>
    </article>
    {
        (prevWork || nextWork) && (
            <div class="my-16 sm:my-24">
                <h2 class="mb-12 text-xl font-serif italic sm:mb-16 sm:text-2xl">View Next</h2>
                {nextWork && <PostPreview post={nextWork} class="mb-10 sm:mb-12" headingLevel="h3" />}
                {prevWork && <PostPreview post={prevWork} class="mb-10 sm:mb-12" headingLevel="h3" />}
            </div>
        )
    }
</BaseLayout>
