---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

// Components
import CallToAction from "../components/CallToAction.astro";
import Grid from "../components/Grid.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import WorkCard from "../components/WorkCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 6);
---

<BaseLayout>
  <div class="flex flex-col gap-30 w-full max-w-6xl mx-auto px-6">
    <header
      class="flex flex-col-reverse md:grid md:grid-cols-10 gap-10 items-center pt-12"
    >
      <div class="md:col-span-6 space-y-4">
        <Hero
          intro="Hello, my name is"
          title="Yimi Lu"
          tagline="I am a writer currently based in Bay Area."
          align="start"
        />
      </div>
      <div class="md:col-span-4">
        <Image
          src="/assets/portrait.jpg"
          alt="Yimi Lu"
          width="480"
          height="480"
          class="rounded-3xl border border-gray-800 object-cover object-top aspect-square"
        />
      </div>
    </header>

    <main class="flex flex-col gap-20">
      <section>
        <div>
          <h2 class="text-4xl lg:text-6xl font-brand text-gray-100">
            Recent Works
          </h2>
        </div>

        <ul class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            projects.map((project) => (
              <li>
                <WorkCard project={project} />
              </li>
            ))
          }
        </ul>

        <div class="mt-8 lg:mt-0 flex justify-start lg:justify-end">
          <CallToAction href="/work/">
            View All
            <Icon icon="arrow-right" size="1.2em" />
          </CallToAction>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
