---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import FictionPreview from '../../components/FictionPreview.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../../utils/data-utils';

export async function getStaticPaths() {
    const fictions = (await getCollection('fictions')).sort(sortItemsByDateDesc);
    const fictionCount = fictions.length;
    return fictions.map((fiction, index) => ({
        params: { id: fiction.id },
        props: {
            fiction,
            prevFiction: index + 1 !== fictionCount ? fictions[index + 1] : null,
            nextFiction: index !== 0 ? fictions[index - 1] : null
        }
    }));
}

type Props = {
    fiction: CollectionEntry<'fictions'>;
    prevFiction: CollectionEntry<'fictions'>;
    nextFiction: CollectionEntry<'fictions'>;
};

const { fiction, prevFiction, nextFiction } = Astro.props;
const { title, description, seo } = fiction.data;
const { Content } = await render(fiction);
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description} image={seo?.image} pageType="article" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight">{title}</h1>
        </header>
        <div class="max-w-none prose sm:prose-lg">
            <Content />
        </div>
    </article>
    {
        (prevFiction || nextFiction) && (
            <div class="my-16 sm:my-24">
                <h2 class="mb-12 text-xl font-serif italic sm:mb-16 sm:text-2xl">View Next</h2>
                {nextFiction && <FictionPreview fiction={nextFiction} class="mb-10 sm:mb-12" headingLevel="h3" />}
                {prevFiction && <FictionPreview fiction={prevFiction} class="mb-10 sm:mb-12" headingLevel="h3" />}
            </div>
        )
    }
</BaseLayout>
