---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/container.astro";
import PostMeta from "../../components/postmeta.astro";

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const workEntries = await getCollection("work", ({ data }) => !data.draft);
  return workEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
  <Container>
    <div class="mx-auto max-w-3xl mt-14">
      <PostMeta
        category={entry.data.category}
        publishDate={entry.data.publishDate}
      />
      <span class="text-hh15-muted">•</span>
      <span class="text-hh15-muted">{entry.data.magazine}</span>
      <h1
        class="text-4xl lg:text-5xl font-bold lg:tracking-tight mt-1 lg:leading-tight"
      >
        {entry.data.title}
      </h1>
    </div>

    <div class="mx-auto prose prose-lg mt-6 max-w-3xl">
      <Content />
    </div>
    <div class="text-center mt-16">
      <a
        href="/work"
        class="bg-[#3b2d2b] text-white px-5 py-3 rounded-md hover:bg-[#2a1f1d] transition"
      >
        ← Back to Work
      </a>
    </div>
  </Container>
</Layout>
