---
interface Props {
  href: string;
  size?: "md" | "lg" | "xl";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted" | "accent";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-5 py-2.5",
  md: "px-4 py-2",
  xl: "px-6 py-3.5 text-xl font-semibold",
};

const btnBase =
  "inline-flex items-center gap-2 rounded-full text-sm font-medium " +
  "transition-colors duration-150 focus:outline-none " +
  "focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-accent/60 " +
  "disabled:opacity-50 disabled:pointer-events-none";

const styles = {
  primary:
    "bg-fg text-card hover:bg-fg/70 border border-transparent",

  outline:
    "bg-card text-fg border border-border hover:bg-card/70",

  inverted:
    "bg-card text-fg border border-border hover:bg-card/90",

  muted:
    "bg-transparent text-fg/80 border border-border hover:bg-card hover:text-fg",

  accent:
    "bg-accent text-white hover:bg-accent/90 border border-transparent",
};
---

<a
  href={href}
  {...rest}
  class:list={[
    btnBase,
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
>
  <slot />
</a>
