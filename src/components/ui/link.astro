---
interface Props {
  href: string;
  size?: "md" | "lg";
  block?: boolean;
  style?: "outline" | "primary" | "inverted" | "muted";
  class?: string;
  [x: string]: any;
}

const {
  href,
  block,
  size = "lg",
  style = "primary",
  class: className,
  ...rest
} = Astro.props;

const sizes = {
  lg: "px-5 py-2.5",
  md: "px-4 py-2",
};

const styles = {
  primary:
    "bg-hh15-fg text-hh15-card hover:bg-hh15-fg/90",

  // 外描边：卡片底 + 轻描边，hover 只做轻底色
  outline:
    "bg-hh15-card text-hh15-fg border border-hh15-fg/25 hover:bg-hh15-bg",

  // 反相：浅底深字，做次级主行动
  inverted:
    "bg-hh15-card text-hh15-fg border border-hh15-border hover:bg-hh15-card/90",

  // 静音：透明底 + 细边，适合次要操作
  muted:
    "bg-transparent text-hh15-fg/80 border border-hh15-border hover:bg-hh15-card hover:text-hh15-fg",

  // 需要“粉色强调”时再用它，别当默认主按钮
  accent:
    "bg-hh15-accent text-hh15-fg hover:bg-hh15-accent/90"

};

 const btnBase =
  "inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-medium " +
  "transition-colors duration-150 focus:outline-none " +
  "focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-hh15-accent/60 " +
  "disabled:opacity-50 disabled:pointer-events-none";

---

<a
  href={href}
  {...rest}
  class:list={[
    btnBase,
    block && "w-full",
    sizes[size],
    styles[style],
    className,
  ]}
  ><slot />
</a>
