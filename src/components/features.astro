---
import { icon } from "@fortawesome/fontawesome-svg-core";
import {
  faBriefcase,
  faDatabase,
  faFileMagnifyingGlass,
  faRobot,
  faUser,
  faWindowMaximize,
} from "@fortawesome/free-solid-svg-icons";

const features = [
  {
    title: "Bring Your Own Framework",
    description:
      "Build your site using React, Svelte, Vue, Preact, web components, or just plain ol' HTML + JavaScript.",
    icon: icon(faBriefcase, { classes: ["size-4"] }).html.join(""),
  },
  {
    title: "100% Static HTML, No JS",
    description:
      "Astro renders your entire page to static HTML, removing all JavaScript from your final build by default.",
    icon: icon(faWindowMaximize, { classes: ["size-4"] }).html.join(""),
  },
  {
    title: "On-Demand Components",
    description:
      "Need some JS? Astro can automatically hydrate interactive components when they become visible on the page.  ",
    icon: icon(faDatabase, { classes: ["size-4"] }).html.join(""),
  },
  {
    title: "Broad Integration",
    description:
      "Astro supports TypeScript, Scoped CSS, CSS Modules, Sass, Tailwind, Markdown, MDX, and any other npm packages.",
    icon: icon(faRobot, { classes: ["size-4"] }).html.join(""),
  },
  {
    title: "SEO Enabled",
    description:
      "Automatic sitemaps, RSS feeds, pagination and collections take the pain out of SEO and syndication. It just works!",
    icon: icon(faFileMagnifyingGlass, { classes: ["size-4"] }).html.join(""),
  },
  {
    title: "Community",
    description:
      "Astro is an open source project powered by hundreds of contributors making thousands of individual contributions.",
    icon: icon(faUser, { classes: ["size-4"] }).html.join(""),
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    Everything you need to start a website
  </h2>
  <p class="text-lg mt-4 text-hh15-muted">
    Astro comes batteries included. It takes the best parts of state-of-the-art
    tools and adds its own innovations.
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-16">
  {
    features.map((item) => (
      <div class="flex gap-4 items-start">
        <div class="mt-1 bg-black rounded-full  p-2 w-8 h-8 shrink-0">
          <span class="text-white" aria-hidden="true" set:html={item.icon} />
        </div>
        <div>
          <h3 class="font-semibold text-lg">{item.title}</h3>{" "}
          <p class="text-hh15-muted mt-2 leading-relaxed">{item.description}</p>
        </div>
      </div>
    ))
  }
</div>
