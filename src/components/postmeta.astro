---
interface Props {
  category: string;
  publishDate: Date;
}
const { category, publishDate } = Astro.props as Props;
const forthcoming = publishDate > new Date();
---
<div class="inline-flex items-center gap-1 text-sm text-muted">
  <span class="uppercase tracking-wider text-accent/80 text-xs font-serif font-medium">{category}</span>
  <span aria-hidden="true">&middot;</span>
  {forthcoming ? (
    <span>Forthcoming</span>
  ) : (
    <time datetime={publishDate.toISOString()}>
      {publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long" })}
    </time>
  )}
</div>
