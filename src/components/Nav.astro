---
import Icon from "./Icon.astro";
import type { iconPaths } from "./IconPaths";

const textLinks: { label: string; href: string }[] = [
  { label: "Home", href: "/" },
  { label: "Work", href: "/work/" },
  { label: "About", href: "/about/" },
];

const isCurrentPage = (href: string) => {
  let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
  if (pathname.at(0) !== "/") pathname = "/" + pathname;
  if (pathname.at(-1) !== "/") pathname += "/";
  return pathname === href || (href !== "/" && pathname.startsWith(href));
};
---

<nav class="w-full px-6 py-6">
  <div
    class="max-w-7xl mx-auto flex flex-col items-center gap-4 md:flex-row md:justify-between md:items-center"
  >
    <!-- Logo / Title -->
    <a
      href="/"
      class="flex items-center gap-2 text-2xl font-brand font-semibold text-gray-400"
    >
      <Icon icon="pencil-line" />
      Yimi Lu
    </a>

    <!-- Navigation Links -->
    <ul class="flex flex-row items-center justify-center gap-6">
      {
        textLinks.map(({ label, href }) => (
          <li>
            <a
              href={href}
              aria-current={isCurrentPage(href) ? "page" : undefined}
              class={`px-1 pb-0.5 border-b-2 text-base font-medium transition-all 
              ${
                isCurrentPage(href)
                  ? "border-accent-regular text-accent-regular"
                  : "border-transparent text-gray-400 hover:text-accent-regular hover:border-accent-regular"
              }`}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>
