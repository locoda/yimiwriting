---
const links = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work/' },
  { label: 'About', href: '/about/' },
];
const isCurrentPage = (href: string) => {
  let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
  if (pathname.at(0) !== '/') pathname = '/' + pathname;
  if (pathname.at(-1) !== '/') pathname += '/';
  return pathname === href || (href !== '/' && pathname.startsWith(href));
};
---

<nav class="w-full px-10 py-6 bg-white/20 border-b border-gray-200 backdrop-blur-sm top-0 z-50">
  <div class="max-w-6xl mx-auto flex flex-wrap items-center justify-between gap-4">
      <a href="/" class="w-8 h-8 block">
    <img src="/favicon.svg" alt="Home" class="w-full h-full object-contain" />
  </a>

    <ul class="flex flex-wrap gap-4 text-base font-brand">
      {links.map(({ label, href }) => (
        <li>
          <a
            href={href}
            aria-current={isCurrentPage(href) ? 'page' : undefined}
            class={`underline-offset-4 transition-colors duration-150 ${
              isCurrentPage(href)
                ? 'text-accent-regular underline'
                : 'text-gray-500 hover:text-accent-regular hover:underline'
            }`}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>
