---
const technologies = ["React", "Svelte", "Astro", "Tailwind CSS", "Alpine.js", "Vercel"];
---

<div class="mt-24">
  <h2 class="text-center text-hh15-muted">Works with your technologies</h2>
  <div class="flex gap-6 md:gap-10 items-center justify-center mt-10 flex-wrap">
    {technologies.map((tech) => (
      <span class="text-sm md:text-base font-semibold text-hh15-muted">
        {tech}
      </span>
    ))}
  </div>
</div>
