---
const { align = "center" } = Astro.props;
---

<div class:list={["mt-16", align === "center" && "text-center"]}>
  <h1 class="font-serif font-bold text-6xl md:text-8xl leading-none tracking-tight">
    <span class="text-hh15-accent">
      <slot name="title">Title</slot>
    </span>
  </h1>
  <p
    class:list={[
      "mt-6 text-lg md:text-xl text-hh15-muted",
      align === "center" && "max-w-md mx-auto",
    ]}
  >
    <slot name="desc">Some description goes here</slot>
  </p>
</div>
