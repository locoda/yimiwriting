---
interface Props {
  intro?: string; // e.g. "Yimi Lu"
  title: string; // e.g. "Hello, my name is"
  tagline?: string;
  align?: "start" | "center";
}

const { title, intro, tagline, align = "center" } = Astro.props;
---

<section
  class={`flex flex-col gap-4 ${align === "center" ? "items-center text-center" : "items-start text-left"}`}
>
  {
    intro && (
      <h2 class="text-4xl md:text-5xl font-medium text-gray-700 font-brand">
        {intro}
      </h2>)
  }

  <h1 class="text-6xl md:text-7xl font-medium text-gray-700 font-brand">
    {title}
  </h1>

  {tagline && <p class="text-lg text-gray-700 max-w-prose">{tagline}</p>}

  <slot />
</section>
