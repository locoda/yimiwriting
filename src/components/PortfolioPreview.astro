---
import type { CollectionEntry } from "astro:content";
import Pill from "./Pill.astro";

interface Props {
  project: CollectionEntry<"work">;
}

const { data } = Astro.props.project;
---

<div class="relative bg-gray-900 border-2 border-gray-200  rounded-xl p-6 flex flex-col justify-between gap-4">
  <h1 class="text-center text-4xl text-grey200 font-brand">{data.title}</h1>

  <p class="text-gray-400 text-base"> {data.description}    </p>

  <div class="flex items-center gap-2 justify-between">
    { <Pill>{data.type}</Pill>}

  {data.external_url ? (
    <a
      href={data.external_url}
      target="_blank"
      rel="noopener"
      class=" text-sm text-accent-regular underline"
    >
      View Work →
    </a>
  ) : (
    <span class="text-sm text-gray-400 italic">
      Forthcoming...
    </span>
  )}
</div>
</div>
