---
import type { CollectionEntry } from "astro:content";
import Pill from "./Pill.astro";

interface Props {
  project: CollectionEntry<"work">;
}

const { data } = Astro.props.project;
---

<div class="relative bg-(--gray-900) border-2 border-(--gray-400)  rounded-xl p-6 flex flex-col justify-between gap-4">
  <h1 class="text-center text-4xl text-[#3b1e25]">{data.title}</h1>

  <p class="text-gray-700 text-base"> {data.description}    </p>

  <div class="flex items-center gap-2">
    {data.tags.map((t) => <Pill>{t}</Pill>)}
  </div>

  {data.external_url ? (
    <a
      href={data.external_url}
      target="_blank"
      rel="noopener"
      class="absolute bottom-4 right-4 text-sm text-pink-500 underline"
    >
      View Work →
    </a>
  ) : (
    <span class="absolute bottom-4 right-4 text-sm text-gray-500 italic">
      Forthcoming...
    </span>
  )}
</div>
