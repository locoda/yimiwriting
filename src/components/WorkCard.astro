---
import type { CollectionEntry } from "astro:content";
import Pill from "./Pill.astro";

interface Props {
  project: CollectionEntry<"work">;
}

const { data, id } = Astro.props.project;
const now = new Date();
const published = new Date(data.publishDate);
---

<div
  class="relative bg-gray-900 border border-gray-400 rounded-xl px-4 py-6 flex flex-col gap-3 shadow-sm"
>
  <h1 class="text-center text-2xl font-brand font-semibold text-gray-200">{data.title}</h1>

  <p class="text-base text-gray-400">{data.description}</p>

  <div class="flex items-center justify-between text-sm text-gray-500">
    {(<Pill>{data.type}</Pill>)}

    {
      now < published ? (
        <span class="italic">Forthcoming...</span>
      ) : data.url ? (
        <a
          href={data.url}
          target="_blank"
          rel="noopener"
          class="text-accent-regular underline"
        >
          View Work →
        </a>
      ) : (
        <a
          href={`/work/${id}`}
          class="text-accent-regular underline"
        >
          View Work →
        </a>
      )
    }
  </div>
</div>