---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<section
  class="flex flex-col items-center justify-center text-center min-h-[calc(70vh)]  gap-4"
>
  <h1 class="font-brand font-bold text-6xl md:text-8xl leading-none tracking-tight drop-shadow-md">
    <span class="text-hh15-fg">Yimi</span><br />
    <span class="text-hh15-accent">Writing</span>
  </h1>
  <div class="h-1 w-32 md:w-48 bg-gradient-to-r from-hh15-accent to-hh15-fg rounded-full"></div>

  <p class="mt-6 text-lg md:text-xl text-hh15-muted max-w-md">
    Always procrastinating, occasionally writing.
  </p>

  <div class="flex gap-6 mt-4 text-hh15-muted">
    <a
      href="https://twitter.com/yimiwriting"
      target="_blank"
      rel="noopener"
      aria-label="Twitter"
      class="hover:text-hh15-fg"
    >
      <Icon class="size-6" name="simple-icons:twitter" />
    </a>
    <a
      href="https://instagram.com/yimiwriting"
      target="_blank"
      rel="noopener"
      aria-label="Instagram"
      class="hover:text-hh15-fg"
    >
      <Icon class="size-6" name="simple-icons:instagram" />
    </a>
    <a
      href="https://www.threads.net/@yimiwriting"
      target="_blank"
      rel="noopener"
      aria-label="Threads"
      class="hover:text-hh15-fg"
    >
      <Icon class="size-6" name="simple-icons:threads" />
    </a>
    <a
      href="https://bsky.app/profile/yimiwriting.bsky.social"
      target="_blank"
      rel="noopener"
      aria-label="Bluesky"
      class="hover:text-hh15-fg"
    >
      <Icon class="size-6" name="simple-icons:bluesky" />
    </a>
  </div>

</section>
