---
import { icon } from "@fortawesome/fontawesome-svg-core";
import {
  faBluesky,
  faInstagram,
  faThreads,
  faTwitter,
} from "@fortawesome/free-brands-svg-icons";
import Link from "./ui/link.astro";

const twitterIcon = icon(faTwitter, { classes: ["size-6"] }).html.join("");
const instagramIcon = icon(faInstagram, { classes: ["size-6"] }).html.join("");
const threadsIcon = icon(faThreads, { classes: ["size-6"] }).html.join("");
const blueskyIcon = icon(faBluesky, { classes: ["size-6"] }).html.join("");
---

  <section
    class="flex flex-col items-center justify-center text-center min-h-[calc(70vh)] gap-6"
  >
  <h1 class="font-sans font-bold text-6xl md:text-8xl leading-none tracking-tight">
    <span class="text-hh15-fg">Yimi</span><br />
    <span class="text-hh15-accent">Writing</span>
  </h1>

    <p class="mt-6 text-lg md:text-xl text-hh15-muted max-w-md">
    Always procrastinating, occasionally writing.
  </p>

    <Link href="/work" style="accent" class="mt-6 font-bold uppercase">READ MY WORKS</Link>

    <div class="flex gap-6 mt-6 text-hh15-muted">
    <a
      href="https://twitter.com/yimiwriting"
      target="_blank"
      rel="noopener"
      aria-label="Twitter"
      class="hover:text-hh15-fg"
    >
      <span aria-hidden="true" set:html={twitterIcon} />
    </a>
    <a
      href="https://instagram.com/yimiwriting"
      target="_blank"
      rel="noopener"
      aria-label="Instagram"
      class="hover:text-hh15-fg"
    >
      <span aria-hidden="true" set:html={instagramIcon} />
    </a>
    <a
      href="https://www.threads.net/@yimiwriting"
      target="_blank"
      rel="noopener"
      aria-label="Threads"
      class="hover:text-hh15-fg"
    >
      <span aria-hidden="true" set:html={threadsIcon} />
    </a>
    <a
      href="https://bsky.app/profile/yimiwriting.bsky.social"
      target="_blank"
      rel="noopener"
      aria-label="Bluesky"
      class="hover:text-hh15-fg"
    >
      <span aria-hidden="true" set:html={blueskyIcon} />
    </a>
  </div>

</section>
