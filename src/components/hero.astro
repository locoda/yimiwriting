---
import { Picture } from "astro:assets";
// import heroImage from "/portrait.jpg";
import Link from "./ui/link.astro";
---

<main class="grid lg:grid-cols-2 place-items-center pb-4 md:pt-8 md:pb-16">
  <div class="relative md:py-6 md:order-1 md:block">
    <Picture src="/portrait.png" alt="Yimi's avatar" width="480" height="480" />
  </div>
  <div>
    <h1
      class="text-5xl lg:text-6xl font-bold lg:tracking-tight xl:tracking-tighter"
    >
      Hi there, this is <span class="relative inline-block">
        Yimi
        <span class="absolute bottom-1 left-0 w-full h-2 bg-hh15-accent -z-10"
        ></span>
      </span>
    </h1>

    <div class="mt-4 h-2 w-40 rounded-full bg-hh15-accent]"></div>

    <!-- <p class="text-lg mt-4 text-hh15-fg max-w-xl">
      Astroship is a starter template for startups, marketing websites & landing
      pages.<wbr /> Built with Astro.build and TailwindCSS. You can quickly
      create any website with this starter.
    </p> -->

    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <Link
        size="xl"
        href="/work"
        style="primary"
        class="flex items-center justify-center"
      >
        <!-- <Icon class="text-white w-5 h-5" name="bx:bxs-cloud-download" /> -->
        My Work
      </Link>
      <Link
        size="xl"
        href="/about"
        style="outline"
        class="flexitems-center justify-center"
      >
        <!-- <Icon class="text-white w-5 h-5" name="bx:bxs-cloud-download" /> -->
        About Me
      </Link>
      <!-- <Link
        size="lg"
        style="outline"
        rel="noopener"
        href="https://github.com/surjithctly/astroship"
        class="flex gap-1 items-center justify-center"
        target="_blank">
        <Icon class="text-black w-4 h-4" name="bx:bxl-github" />
         GitHub Repo
      </Link> -->
    </div>
  </div>
</main>
