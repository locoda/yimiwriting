---
import bx from "@iconify-json/bx/icons.json";
import simpleIcons from "@iconify-json/simple-icons/icons.json";

const { name, class: className = "" } = Astro.props;

const iconSets = {
  "bx": bx,
  "simple-icons": simpleIcons,
};

const [setName, iconName] = name?.split(":") ?? [];
const iconSet = iconSets[setName];
const icon = iconSet?.icons?.[iconName];
const width = icon?.width ?? iconSet?.width ?? 24;
const height = icon?.height ?? iconSet?.height ?? 24;
const viewBox = `0 0 ${width} ${height}`;
---

{icon ? (
  <svg
    class={className}
    viewBox={viewBox}
    role="img"
    aria-hidden="true"
    fill="currentColor"
    set:html={icon.body}
  />
) : (
  <span class={className} aria-hidden="true" />
)}
