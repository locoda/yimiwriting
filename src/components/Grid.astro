---
// Grid.astro
interface Props {
  variant?: 'offset' | 'small';
}

const { variant } = Astro.props;

let className = 'grid gap-4 auto-rows-fr p-0 list-none';

if (variant === 'small') {
  className += ' sm:grid-cols-2 gap-6 sm:flex sm:flex-wrap sm:justify-center sm:gap-8';
}

if (variant === 'offset') {
  className += ' sm:grid-cols-2 sm:gap-16 lg:grid-cols-3';
}
---

<ul class={className}>
  <slot />
</ul>
